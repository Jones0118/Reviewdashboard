   <!-- SMC -->
   <Row><Cell ss:StyleID="mod" ss:MergeAcross="5"><Data ss:Type="String">11. SMC (School Management Committee)</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">SMC</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">SMC resolutions raised</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">SUM(SMC resolutions raised)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Neutral</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Real (KPI modules)</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">SMC</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Resolutions closed</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">SUM(SMC resolutions closed)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Neutral (higher better)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Real (KPI modules)</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">SMC</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Pending resolutions</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">SUM(raised) - SUM(closed), floored at 0</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Neutral (lower better)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Real (KPI modules)</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">SMC</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Closure rate %</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">%</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">SUM(closed) / SUM(raised) x 100</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Range 0-100 (higher better)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Real (KPI modules)</Data></Cell></Row>
   <Row><Cell ss:StyleID="ph"><Data ss:Type="String">SMC</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Emergency resolutions</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">SUM(resolutions flagged emergency)</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Neutral (lower better)</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">PLACEHOLDER — not scoped below state</Data></Cell></Row>

   <!-- PALLI PAARVAI -->
   <Row><Cell ss:StyleID="mod" ss:MergeAcross="5"><Data ss:Type="String">12. Palli Paarvai</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">Palli Paarvai</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Target schools</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">SUM(schools targeted for visit)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Neutral</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Real (KPI modules)</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">Palli Paarvai</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Schools visited</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">SUM(schools visited)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Neutral (higher better)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Real (KPI modules)</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">Palli Paarvai</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Schools not visited</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">SUM(target) - SUM(visited), floored at 0</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Neutral (lower better)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Real (KPI modules)</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">Palli Paarvai</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Visit completion %</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">%</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">SUM(visited) / SUM(target) x 100</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Range 0-100 (higher better)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Real (KPI modules)</Data></Cell></Row>
   <Row><Cell ss:StyleID="ph"><Data ss:Type="String">Palli Paarvai</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Officials with 0 school visits</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">COUNT(officials who visited no schools)</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Neutral (lower better)</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">PLACEHOLDER — no official-level data</Data></Cell></Row>

   <Row></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">Legend</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Orange italic rows = PLACEHOLDER KPI (shows "–" in the dashboard until the source field is connected).</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">RAG</Data></Cell><Cell ss:StyleID="cell" ss:MergeAcross="4"><Data ss:Type="String">For % KPIs: normalise value into its [lo,hi] range (invert if lower-is-better); score &gt;0.66 = green, &gt;0.33 = amber, else red. Count KPIs are neutral (no RAG cut-off invented).</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">Scope aggregation</Data></Cell><Cell ss:StyleID="cell" ss:MergeAcross="4"><Data ss:Type="String">Percentages are student-weighted across the units in the current scope (State / District / Block); counts are summed.</Data></Cell></Row>
  </Table>
