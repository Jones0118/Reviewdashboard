   <Row><Cell ss:StyleID="mod" ss:MergeAcross="5"><Data ss:Type="String">9. Scholarship</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">Scholarship</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Scholarship eligibility %</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">%</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">SUM(eligible) / SUM(total students in scheme) x 100</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Range 70-98 (higher better)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Real (KPI modules)</Data></Cell></Row>
