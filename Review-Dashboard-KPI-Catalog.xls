<?xml version="1.0"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:o="urn:schemas-microsoft-com:office:office"
 xmlns:x="urn:schemas-microsoft-com:office:excel"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet">
 <Styles>
  <Style ss:ID="title"><Font ss:Bold="1" ss:Size="14"/></Style>
  <Style ss:ID="hdr">
   <Font ss:Bold="1" ss:Color="#FFFFFF"/>
   <Interior ss:Color="#1F4E79" ss:Pattern="Solid"/>
   <Alignment ss:Vertical="Center" ss:WrapText="1"/>
  </Style>
  <Style ss:ID="mod">
   <Font ss:Bold="1" ss:Color="#FFFFFF"/>
   <Interior ss:Color="#0F766E" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="cell"><Alignment ss:Vertical="Top" ss:WrapText="1"/></Style>
  <Style ss:ID="ph"><Alignment ss:Vertical="Top" ss:WrapText="1"/><Font ss:Color="#B45309" ss:Italic="1"/></Style>
 </Styles>
 <Worksheet ss:Name="KPI Catalog">
  <Table>
   <Column ss:Width="120"/>
   <Column ss:Width="150"/>
   <Column ss:Width="70"/>
   <Column ss:Width="300"/>
   <Column ss:Width="200"/>
   <Column ss:Width="110"/>
   <Row><Cell ss:StyleID="title"><Data ss:Type="String">State Monitoring &amp; Review Dashboard — Component / KPI Catalog with Formulas</Data></Cell></Row>
   <Row></Row>
   <Row>
    <Cell ss:StyleID="hdr"><Data ss:Type="String">Component (Module)</Data></Cell>
    <Cell ss:StyleID="hdr"><Data ss:Type="String">KPI</Data></Cell>
    <Cell ss:StyleID="hdr"><Data ss:Type="String">Unit</Data></Cell>
    <Cell ss:StyleID="hdr"><Data ss:Type="String">Formula / Definition</Data></Cell>
    <Cell ss:StyleID="hdr"><Data ss:Type="String">RAG rule (green / amber / red)</Data></Cell>
    <Cell ss:StyleID="hdr"><Data ss:Type="String">Data source</Data></Cell>
   </Row>

   <!-- STATE SUMMARY -->
   <Row><Cell ss:StyleID="mod" ss:MergeAcross="5"><Data ss:Type="String">1. State Summary</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">State Summary</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Schools</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">SUM(schools) across all units in scope</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Neutral (no RAG)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Real (enrolment)</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">State Summary</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Students</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">SUM(students) across all units in scope</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Neutral</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Real (enrolment)</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">State Summary</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Teachers</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">SUM(teaching staff) across all units in scope</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Neutral</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Real (enrolment)</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">State Summary</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Student attendance %</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">%</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Student-weighted avg: SUM(attendance% x students) / SUM(students)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Range 82-97: &gt;91.9 green, &gt;86.9 amber, else red (higher better)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Real (attendance)</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">State Summary</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Teacher attendance %</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">%</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Student-weighted avg of teacher attendance%</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Range 91-99 (higher better)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Real (attendance)</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">State Summary</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Potential dropouts (15 days absent)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">SUM(students absent 15+ days in the month)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Neutral (lower better)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Real (attendance)</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">State Summary</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Schools with critical infra gap</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">COUNT(schools failing any real check: zero toilets/water/classrooms/urinals/furniture or water not functional)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Neutral (lower better)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Real (infrastructure)</Data></Cell></Row>

   <!-- ENROLLMENT -->
   <Row><Cell ss:StyleID="mod" ss:MergeAcross="5"><Data ss:Type="String">2. Enrollment</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">Enrollment</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Students</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">SUM(students) in scope</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Neutral</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Real (enrolment)</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">Enrollment</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Enrollment change %</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">%</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">(students this year - students last year) / students last year x 100</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Range -6..8 (higher better)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Real (enrolment trend)</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">Enrollment</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Girls %</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">%</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">SUM(girls) / SUM(students) x 100</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Range 46-52 (neutral / informational)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Real (enrolment)</Data></Cell></Row>
   <Row><Cell ss:StyleID="ph"><Data ss:Type="String">Enrollment</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">CWSN enrollment %</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">%</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">SUM(CWSN students) / SUM(students) x 100 — CWSN = Children With Special Needs</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Range 1-4 (higher better)</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">PLACEHOLDER — no CWSN field in data yet</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">Enrollment</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Dropout rate %</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">%</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Student-weighted avg of dropout rate (from attendance node)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Range 0.5-4 (lower better)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Real (attendance)</Data></Cell></Row>
   <Row><Cell ss:StyleID="ph"><Data ss:Type="String">Enrollment</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Schools with declined enrollment</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">COUNT(schools where students this year &lt; students last year)</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Neutral (lower better)</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">PLACEHOLDER — needs per-school year-over-year</Data></Cell></Row>

   <!-- ATTENDANCE -->
   <Row><Cell ss:StyleID="mod" ss:MergeAcross="5"><Data ss:Type="String">3. Attendance</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">Attendance</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Student attendance %</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">%</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">SUM(present student-days) / SUM(expected student-days) x 100; aggregated student-weighted</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Range 82-97 (higher better)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Real (attendance)</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">Attendance</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Teacher attendance %</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">%</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">SUM(teacher present-days) / SUM(teacher expected-days) x 100</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Range 91-99 (higher better)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Real (attendance)</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">Attendance</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Attendance marking compliance %</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">%</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">SUM(marked school-days) / SUM(expected school-days) x 100</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Range 75-100 (higher better)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Real (attendance)</Data></Cell></Row>
   <Row><Cell ss:StyleID="ph"><Data ss:Type="String">Attendance</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Schools pending attendance</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">COUNT(schools that have not marked attendance for the period)</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Neutral (lower better)</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">PLACEHOLDER — no per-school pending flag</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">Attendance</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Potential dropouts (15 days absent)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">SUM(students absent 15+ days in the month)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Neutral (lower better)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Real (attendance)</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">Attendance</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Teachers absent 30+ days</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Estimated long-leave teachers (derived from teaching-staff count)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Neutral (lower better)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Estimated</Data></Cell></Row>

   <!-- INFRASTRUCTURE -->
   <Row><Cell ss:StyleID="mod" ss:MergeAcross="5"><Data ss:Type="String">4. Infrastructure</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">Infrastructure</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Schools with critical infra gap</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">COUNT(distinct schools failing any real check: zero toilets / water / classrooms / urinals / furniture / water not functional)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Neutral (lower better)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Real (infrastructure)</Data></Cell></Row>
   <Row><Cell ss:StyleID="ph"><Data ss:Type="String">Infrastructure</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">No functional toilet</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">COUNT(schools with 0 functional toilets)</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Neutral (lower better)</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">PLACEHOLDER — not broken out per district</Data></Cell></Row>
   <Row><Cell ss:StyleID="ph"><Data ss:Type="String">Infrastructure</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">No drinking water</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">COUNT(schools with no functional drinking water)</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Neutral (lower better)</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">PLACEHOLDER</Data></Cell></Row>
   <Row><Cell ss:StyleID="ph"><Data ss:Type="String">Infrastructure</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">No CWSN toilet</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">COUNT(schools with no CWSN-accessible toilet)</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Neutral (lower better)</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">PLACEHOLDER — no field in data</Data></Cell></Row>
   <Row><Cell ss:StyleID="ph"><Data ss:Type="String">Infrastructure</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">No EB connection</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">COUNT(schools with no electricity board connection)</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Neutral (lower better)</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">PLACEHOLDER — no field in data</Data></Cell></Row>
   <Row><Cell ss:StyleID="ph"><Data ss:Type="String">Infrastructure</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Kitchen shed unavailable</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">COUNT(schools with no kitchen shed)</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Neutral (lower better)</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">PLACEHOLDER — no field in data</Data></Cell></Row>
   <Row><Cell ss:StyleID="ph"><Data ss:Type="String">Infrastructure</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Building to be demolished</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">COUNT(schools with a building flagged for demolition)</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Neutral (lower better)</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">PLACEHOLDER — no field in data</Data></Cell></Row>
   <Row><Cell ss:StyleID="ph"><Data ss:Type="String">Infrastructure</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Repair &amp; renovation pending</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">COUNT(schools with pending repair/renovation)</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Neutral (lower better)</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">PLACEHOLDER — no field in data</Data></Cell></Row>

   <!-- ACADEMIC PERFORMANCE -->
   <Row><Cell ss:StyleID="mod" ss:MergeAcross="5"><Data ss:Type="String">5. Academic Performance</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">Academic Performance</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Overall academic score %</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">%</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Average exam mark % for the selected period, student-weighted across scope</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Range 45-80 (higher better)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Real (academic)</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">Academic Performance</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Improvement over last year %</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">%</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Current period avg mark - previous period avg mark (percentage points)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Range -3..9 (higher better)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Real (academic)</Data></Cell></Row>
   <Row><Cell ss:StyleID="ph"><Data ss:Type="String">Academic Performance</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">SLAS score %</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">%</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">State Learning Achievement Survey score</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Range 40-75 (higher better)</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">PLACEHOLDER — no SLAS field</Data></Cell></Row>
   <Row><Cell ss:StyleID="ph"><Data ss:Type="String">Academic Performance</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Schools improved</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">COUNT(schools with avg mark higher than previous period)</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Neutral (higher better)</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">PLACEHOLDER — needs per-school delta</Data></Cell></Row>
   <Row><Cell ss:StyleID="ph"><Data ss:Type="String">Academic Performance</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Schools declined</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">COUNT(schools with avg mark lower than previous period)</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Neutral (lower better)</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">PLACEHOLDER — needs per-school delta</Data></Cell></Row>

   <!-- SCHEMES COVERAGE -->
   <Row><Cell ss:StyleID="mod" ss:MergeAcross="5"><Data ss:Type="String">6. Schemes Coverage</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">Schemes Coverage</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Thiran coverage %</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">%</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">SUM(Thiran assessed) / SUM(Thiran eligible) x 100</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Range 60-100 (higher better)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Real (schemes)</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">Schemes Coverage</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">TN SPARK coverage %</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">%</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">SUM(TN SPARK students) / SUM(students) x 100</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Range 55-98 (higher better)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Real (schemes)</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">Schemes Coverage</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Breakfast scheme coverage %</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">%</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">SUM(breakfast served) / SUM(breakfast eligible) x 100</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Range 85-100 (higher better)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Real (schemes)</Data></Cell></Row>
   <Row><Cell ss:StyleID="ph"><Data ss:Type="String">Schemes Coverage</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Breakfast exception schools</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">COUNT(schools not serving breakfast as expected)</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Neutral (lower better)</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">PLACEHOLDER — no exception flag</Data></Cell></Row>

   <!-- GRIEVANCE & SUPPORT -->
   <Row><Cell ss:StyleID="mod" ss:MergeAcross="5"><Data ss:Type="String">7. Grievance &amp; Support</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">Grievance &amp; Support</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">CM Cell open petitions</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">SUM(CM Cell pending petitions)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Neutral (lower better)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Real (schemes/grievance)</Data></Cell></Row>
   <Row><Cell ss:StyleID="ph"><Data ss:Type="String">Grievance &amp; Support</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">CM Cell critical petitions</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">SUM(CM Cell petitions flagged critical)</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">Neutral (lower better)</Data></Cell><Cell ss:StyleID="ph"><Data ss:Type="String">PLACEHOLDER — no critical flag on CM Cell</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">Grievance &amp; Support</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">14417 open cases</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">SUM(14417 cases) - SUM(14417 resolved)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Neutral (lower better)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Real (schemes/grievance)</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">Grievance &amp; Support</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">14417 critical cases</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">SUM(14417 cases flagged critical)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Neutral (lower better)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Real (schemes/grievance)</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">Grievance &amp; Support</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">14417 resolution %</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">%</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">SUM(14417 resolved) / SUM(14417 cases) x 100</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Range 70-99 (higher better)</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Real (schemes/grievance)</Data></Cell></Row>

   <!-- THIRAN+ -->
   <Row><Cell ss:StyleID="mod" ss:MergeAcross="5"><Data ss:Type="String">8. THIRAN+</Data></Cell></Row>
   <Row><Cell ss:StyleID="cell"><Data ss:Type="String">THIRAN+</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">THIRAN+ students identified</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Count</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">SUM(Thiran students) in scope</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Neutral</Data></Cell><Cell ss:StyleID="cell"><Data ss:Type="String">Real (KPI modules)</Data></Cell></Row>
